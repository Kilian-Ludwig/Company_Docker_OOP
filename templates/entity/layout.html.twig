<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Company App{% endblock %}</title>
    <link rel="stylesheet" href="./assets/css/style.css">
</head>
<body>

<header class="navbar">
    <div class="navbar-brand">
        <a href="http://www.company.bbq">Company App</a>
    </div>
    <nav class="navbar-links">
        <a href="http://www.company.bbq/employee/show">Mitarbeiter</a>
        <a href="http://www.company.bbq/department/show">Abteilungen</a>
        <a href="http://www.company.bbq/project/show">Projekte</a>
        <a href="http://www.company.bbq/skill/show">Skills</a>
    </nav>
</header>

<main class="container">
    {% block content %}{% endblock %}
</main>

<footer class="footer">
    <p>&copy; {{ "now"|date("Y") }} Company App</p>
</footer>

</body>
</html>
