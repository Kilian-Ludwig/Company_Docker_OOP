<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Company App{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<header class="navbar">
    <div class="navbar-brand">
        <a href="http://www.company.bbq">Company App</a>
    </div>
    <div class="navbar-brand">
        <a href="http://www.company.bbq/users/logout">Logout</a>
    </div>
    <nav class="navbar-links">
        <a href="http://www.company.bbq/employee/show">Employees</a>
        <a href="http://www.company.bbq/department/show">Departments</a>
        <a href="http://www.company.bbq/project/show">Projects</a>
        <a href="http://www.company.bbq/skill/show">Skills</a>
    </nav>
</header>
{% if errors is defined and errors %}
    <ul class="errors">
        {% for error in errors %}
            <li>{{ error }}</li>
        {% endfor %}
    </ul>
{% endif %}

<main class="container">
    {% block content %}{% endblock %}
</main>

<footer class="footer">
    <p>Company App</p>
</footer>

</body>
</html>
