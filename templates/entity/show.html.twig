{% extends "layout.html.twig" %}

{% block title %}{{ className }} Details{% endblock %}

{% block content %}
    <h1>{{ className }} Details</h1>

    <table class="detail-table">
        <tbody>
        {% for key, value in entity.getProperties(false,true,true) %}
            <tr>
                <th>{{ key }}</th>
                <td>{{ value }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="actions">
        <a href="http://www.company.bbq/{{ entityName }}/update/{{ entity.id }}">
            <button class="btn btn-primary">Change</button>
        </a>
        <a href="http://www.company.bbq/{{ entityName }}/update/{{ entity.id }}"
           onclick="return confirm('Are you sure you want to delete?');">
            <button class="btn btn-danger">Delete</button>
        </a>
        <a href="http://www.company.bbq/{{ entityName }}/show">
            <button class="btn btn-secondary">Back to List</button>
        </a>
    </div>
{% endblock %}
