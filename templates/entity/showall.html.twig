{% extends "layout.html.twig" %}

{% block title %}{{ className }} List{% endblock %}

{% block content %}
    <h1>{{ className }} List</h1>

    {% if data|length == 0 %}
        <p>No Data</p>
    {% else %}
        <table class="list-table">
            <thead>
            <tr>
                {% for key, value in data[0].getProperties() %}
                    <th>{{ key }}</th>
                {% endfor %}
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            {% for entity in data %}
                <tr>
                    {% for key, value in entity.getProperties() %}
                        <td>
                            {{ value }}
                        </td>
                    {% endfor %}
                    <td class="actions">
                        <a href="http://www.company.bbq/{{ entityName }}/show/{{ entity.id }}">
                            <button class="btn btn-sm">Details</button>
                        </a>
                        <a href="http://www.company.bbq/{{ entityName }}/update/{{ entity.id }}">
                            <button class="btn btn-sm btn-primary">Update</button>
                        </a>
                        <a href="http://www.company.bbq/{{ entityName }}/delete/{{ entity.id }}"
                           onclick="return confirm('Are you sure you want to delete ?');">
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    <div class="actions">
        <a href="http://www.company.bbq/{{ entityName }}/create">
            <button class="btn btn-success">create {{ className }}</button>
        </a>
    </div>
{% endblock %}
