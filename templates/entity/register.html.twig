{% extends 'layout.html.twig' %}

{% block title %}Registration{% endblock %}

{% block content %}
    <h1>Registration</h1>


    {% if errors is defined and errors %}
        <ul class="errors">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <form class="form" method="post">
        <div>
            <label for="email">E-Mail</label>
            <input
                    type="email"
                    id="email"
                    name="email"
                    required
            >
        </div>

        <div>
            <label for="password">Password</label>
            <input
                    type="password"
                    id="password"
                    name="password"
                    required
                    minlength="8"
            >
        </div>

        <div>
            <label for="password_repeat">Repeat Password</label>
            <input
                    type="password"
                    id="password_repeat"
                    name="password_repeat"
                    required
                    minlength="8"
            >
        </div>

        <button type="submit">Register</button>
    </form>
    <p>
        you are already registered ?
        <a href="http://www.company.bbq">Login</a>
    </p>
{% endblock %}