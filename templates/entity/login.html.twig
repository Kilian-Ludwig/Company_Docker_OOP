{% extends 'layout.html.twig' %}

{% block title %}Login{% endblock %}

{% block content %}
    {% if status %}
    <h1>Login</h1>
    {% else %}
        <h1>Login failed</h1>
    {% endif %}

{#    {% if errors is defined and errors %}#}
{#        <ul class="errors">#}
{#            {% for error in errors %}#}
{#                <li>{{ error }}</li>#}
{#            {% endfor %}#}
{#        </ul>#}
{#    {% endif %}#}
    <form class="form" method="post">
        <div>
            <label for="email">E-Mail</label>
            <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    value=""
            >
        </div>

        <div>
            <label for="password">Password</label>
            <input
                    type="password"
                    id="password"
                    name="password"
                    required
            >
        </div>

        <button type="submit">Login</button>
    </form>

    <p>
        you are not registered ?
        <a href="http://www.company.bbq/users/register">Register now</a>
    </p>
{% endblock %}
